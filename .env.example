# =====================================================================
# PRASHANTH HOSPITALS — CALL CENTER & SLM PLATFORM ENVIRONMENT CONFIG
# =====================================================================

# Application Environment
APP_NAME="Prashanth Hospitals Call Center & SLM Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Operational Database Connection & Connection Pool Settings
# Use "ph-postgres" as host when running via docker-compose (service DNS name);
# use "localhost" only when running the backend directly against a local Postgres.
DATABASE_URL=postgresql+psycopg2://ph_db_user:ph_secure_pass@ph-postgres:5432/ph_callcenter_slm_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Credentials the ph-postgres container itself is provisioned with
# (must stay in sync with the user/password/db above)
POSTGRES_USER=ph_db_user
POSTGRES_PASSWORD=ph_secure_pass
POSTGRES_DB=ph_callcenter_slm_db

# XTEND DB2 Central Hub Replication Parameters (Kolathur Branch)
XTEND_DB2_HOST=192.168.1.100
XTEND_DB2_PORT=50000
XTEND_DB2_USER=xtend_sync_user
XTEND_DB2_PASSWORD=xtend_secure_pass_placeholder
XTEND_DB2_DATABASE=XTENDDB2

# Firebase Cloud Messaging (FCM) Credentials
FCM_SERVER_KEY=AAAA-fcm-server-key-placeholder
FCM_PROJECT_ID=prashanth-hospitals-slm

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
